<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <!-- O layout usa coordenadas HD (1280 x 720). translation posiciona cada
         node em relação ao seu pai, e não necessariamente à tela inteira.
         Os filhos são desenhados em ordem: o Video, por último, cobre a cena. -->
    <children>
        <Rectangle width="1280" height="720" color="0x0B1220FF" />
        <Rectangle translation="[0,0]" width="1280" height="6" color="0x8B5CF6FF" />
        <Label translation="[60,30]" width="1160" height="55" text="ROKU SHOWCASE" font="font:LargeBoldSystemFont" />
        <Label translation="[60,87]" width="1160" height="32" text="Seu catálogo de vídeos de teste" color="0xA8B4C8FF" />
        <Label id="status" translation="[60,126]" width="1160" height="32" text="Carregando catálogo..." font="font:SmallSystemFont" color="0xA8B4C8FF" />
        <!-- itemSize define a linha; rowItemSize define cada cartão. numRows é
             a quantidade de linhas visíveis, não o total de categorias.
             A borda de foco é desenhada pelo PosterItem, por isso desativamos
             o indicador padrão com drawFocusFeedback=false. -->
        <RowList id="catalog" translation="[60,180]" itemComponentName="PosterItem"
            numRows="2" itemSize="[1160,235]" rowItemSize="[[260,180]]"
            rowItemSpacing="[[20,0]]" rowLabelOffset="[0,10]" showRowLabel="[true]"
            focusXOffset="[0]" drawFocusFeedback="false" visible="false" />
        <!-- Group organiza os detalhes, mas não fornece navegação automática.
             MainScene.brs atribui o foco à cena enquanto esta tela está aberta. -->
        <Group id="details" visible="false">
            <Rectangle translation="[60,180]" width="300" height="200" color="0x18243AFF" />
            <Poster id="detailPoster" translation="[70,190]" width="280" height="180" loadDisplayMode="scaleToFit" />
            <Label id="detailTitle" translation="[400,180]" width="780" height="100" wrap="true" font="font:LargeBoldSystemFont" />
            <Label id="detailDescription" translation="[400,300]" width="760" height="180" wrap="true" color="0xC5CFDEFF" />
            <Rectangle translation="[60,540]" width="1160" height="90" color="0x18243AFF" />
            <Label id="detailHint" translation="[80,555]" width="1120" height="60" wrap="true" font="font:SmallSystemFont" />
        </Group>
        <!-- Video fornece reprodução e controles nativos. Escondê-lo não para
             a mídia: o script também precisa enviar control="stop" ao sair. -->
        <Video id="video" width="1280" height="720" visible="false" />
    </children>
</component>
