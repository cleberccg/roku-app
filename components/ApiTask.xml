<?xml version="1.0" encoding="utf-8"?>
<component name="ApiTask" extends="Task">
    <!-- Contrato entre Task e cena: content entrega o array de vídeos;
         error entrega uma mensagem quando não há resultado válido. -->
    <interface>
        <field id="content" type="array" />
        <field id="error" type="string" value="" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/ApiTask.brs" />
</component>
